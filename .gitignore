# Ignore build artifacts
**/bin/
**/obj/
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo

# Others
*.log
*.tmp

# macOS
.DS_Store

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ML raw data (never commit vendor datasets; keep only .gitkeep markers).
# Subdirectories are re-included so the "!.gitkeep" exception can reach them;
# their contents are still ignored by the ml/data/raw/** rule.
ml/data/raw/**
!ml/data/raw/
!ml/data/raw/*/
!ml/data/raw/**/.gitkeep

# Processed ML datasets (regeneratable from raw + code)
ml/data/processed/*.csv
ml/data/processed/*.parquet
ml/data/processed/*.npy
ml/data/processed/*.npz

# Trained model artifacts + per-run experiment metadata
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.json

# Scientific raw signal files (e.g. CWRU MATLAB recordings)
*.mat

# Generated columnar data (does not untrack files already committed)
*.parquet
# ── Spark runtime / generated state ───────────────────────────────────────
# Streaming checkpoints, the Ivy jar cache, the embedded Derby metastore,
# the Hive warehouse, and streaming inference output are all regenerated
# at run time and must never be committed.
#
# NOTE: ~6,400 files under spark/.ivy2, spark/metastore, spark/hive-warehouse
# and spark/checkpoints were committed before this rule existed, so they
# remain tracked — a .gitignore rule does not untrack an existing file.
# See ml/streaming/README.md ("Repository hygiene") for the cleanup command.
spark/checkpoints/**
!spark/checkpoints/.gitkeep
spark/.ivy2/
spark/metastore/
spark/hive-warehouse/
spark/inference-output/
